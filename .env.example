# 社内サーバー PC の lumen-photo フォルダで、このファイルを .env にコピーしてキーを貼る。
#   copy .env.example .env
# .env は Git に上げない（gitignore 済み）。

# Gemini（キャプション生成）。サーバーが Google へ中継するので、ブラウザには送らない。
GEMINI_API_KEY=

# Google マップ（ストリートビュー取り込み）。Maps JavaScript API の仕様上、キーは画面に渡る。
# 渡すのは Cloudflare 経由（Google ログイン済み）の画面だけ。社内 LAN 直の http://192.168.0.39:8510 には渡さない。
# Google Cloud 側でウェブサイト制限に https://lumen.n-kyouei-system.com/* を入れること。
GOOGLE_MAPS_API_KEY=
